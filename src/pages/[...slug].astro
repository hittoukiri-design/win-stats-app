---
import { Head } from "@/components/Head";
import AppRouter from "@/components/Router";
import "@wix/wix-vibe-plugins/plugins-vars.css";
import "@wix/wix-vibe-plugins/plugins-theme.css";
import "@/styles/global.css";

const pathname = Astro.url.pathname;
const normalizedPath = pathname.replace(/\/+$/, "") || "/";
const isHome = normalizedPath === "/";
const siteUrl = "https://win-stats-app.co";
const canonicalUrl = new URL(normalizedPath, siteUrl).href;

const formatPathname = (path: string) => {
  return path
    .replace(/^\/+|\/+$/g, "")
    .split("/")
    .join(" ")
    .split("-")
    .join(" ")
    .trim();
};

const gamehubPromoArticlePaths = [
  "/blog/gamehub-daily-salary-promotion-india",
  "/blog/gamehub-referral-promotion-india",
  "/blog/gamehub-deposit-bonus-promotion-india",
  "/blog/gamehub-ads-fee-promotion-india"
];

const isGameHubRelatedPath =
  normalizedPath === "/blog/unlock-your-potential-discover-gamehubapp" ||
  normalizedPath === "/gamehubapp" ||
  gamehubPromoArticlePaths.includes(normalizedPath);

const gamehubPromoProfiles = {
  "/blog/gamehub-daily-salary-promotion-india": {
    name: "GameHub Daily Salary Promotion India",
    title: "GameHub Daily Salary Promotion India | Early Promoter Guide",
    description: "Read the GameHub daily salary promotion guide for Indian promoters preparing account guidance, member support flow, launch timing, and responsible campaign messaging.",
    keywords: "GameHub daily salary promotion, GameHub promoter India, GameHub agent opportunity, GameHub referral guide",
    type: "Article"
  },
  "/blog/gamehub-referral-promotion-india": {
    name: "GameHub Referral Promotion India",
    title: "GameHub Referral Promotion India | Build Your Network Early",
    description: "A GameHub referral promotion guide for Indian users who want to build a cleaner member network with login guidance, support links, and responsible messaging.",
    keywords: "GameHub referral promotion, GameHub referral India, GameHub member network, GameHub agent guide",
    type: "Article"
  },
  "/blog/gamehub-deposit-bonus-promotion-india": {
    name: "GameHub Deposit Bonus India",
    title: "GameHub Deposit Bonus India | Launch Offer Preparation Guide",
    description: "Prepare for GameHub deposit bonus campaigns with recharge proof, bonus terms, UID readiness, safer play habits, and official GameHub guide links.",
    keywords: "GameHub deposit bonus, GameHub bonus India, GameHub recharge bonus, GameHub launch offer",
    type: "Article"
  },
  "/blog/gamehub-ads-fee-promotion-india": {
    name: "GameHub Ads Fee Promotion India",
    title: "GameHub Ads Fee Promotion India | Campaign Checklist for Promoters",
    description: "A GameHub ads fee promotion checklist for serious promoters planning cleaner creatives, official guide links, member education, and safer campaign expectations.",
    keywords: "GameHub ads fee promotion, GameHub promoter campaign, GameHub ads guide, GameHub agent India",
    type: "Article"
  }
};

const pageProfiles = {
  "/": {
    name: "Home",
    title: "GameInsights Game Login | Real Money Games, UPI Payments & Fast Withdrawal",
    description: "GameInsights Game is an India-focused online gaming platform for lottery, Aviator, slots, casino, sports and real money games with quick registration, UPI-friendly payments, bonuses and fast withdrawal guides.",
    keywords: "GameInsights Game Login, GameInsights Login, GameInsights Game, GameInsights App, GameInsights Register, GameInsights Download, Real Money Games India, Aviator Game India, Online Gaming India, UPI Betting India",
    type: "WebSite"
  },
  "/login": {
    name: "GameInsights Game Login",
    title: "GameInsights Game Login | Secure Account Access & Fast Start Guide",
    description: "Use the GameInsights Game login guide to access your account, recover passwords, check secure sign-in steps, and return to real money games on mobile.",
    keywords: "GameInsights Game Login, GameInsights Login, GameInsights account login, GameInsights password help",
    type: "WebPage"
  },
  "/register": {
    name: "GameInsights Register",
    title: "GameInsights Register | Create Account & Claim Welcome Bonus",
    description: "Create a GameInsights account, review the registration steps, prepare your mobile number, and start with the available welcome bonus for new players.",
    keywords: "GameInsights Register, GameInsights signup, GameInsights welcome bonus, GameInsights invitation code",
    type: "WebPage"
  },
  "/download": {
    name: "GameInsights App Download",
    title: "GameInsights App Download | Android Setup & Mobile Gaming Guide",
    description: "Download and install the GameInsights app for Android, review setup steps, and learn how to start playing mobile games with secure payment support.",
    keywords: "GameInsights app download, GameInsights APK, GameInsights Android app, GameInsights mobile gaming",
    type: "WebPage"
  },
  "/games": {
    name: "GameInsights Games",
    title: "GameInsights Games | Lottery, Casino, Slots, Sports & Fishing",
    description: "Explore GameInsights game categories including lottery, casino, slots, sports, fishing, and original games for Indian mobile players.",
    keywords: "GameInsights games, GameInsights lottery, GameInsights casino, GameInsights slots, GameInsights Aviator",
    type: "CollectionPage"
  },
  "/how-to-play": {
    name: "How to Play GameInsights",
    title: "How to Play GameInsights | Register, Deposit, Withdraw & Start Gaming",
    description: "Learn how to play on GameInsights with simple steps for download, registration, login, deposits, withdrawals, and account safety.",
    keywords: "How to play GameInsights, GameInsights deposit, GameInsights withdrawal, GameInsights guide",
    type: "WebPage"
  },
  "/bonuses": {
    name: "GameInsights Bonuses",
    title: "GameInsights Bonuses | Welcome Rewards, Referral Offers & Daily Benefits",
    description: "Review GameInsights bonus options including welcome rewards, referral benefits, daily offers, and player-friendly reward tiers.",
    keywords: "GameInsights bonus, GameInsights gift code, GameInsights referral bonus, GameInsights promotion",
    type: "WebPage"
  },
  "/blog": {
    name: "GameInsights Blog",
    title: "GameInsights Blog | Online Gaming Guides for Indian Players",
    description: "Read GameInsights guides about online gaming, fast withdrawal, UPI payments, betting tips, account setup, and safer mobile play in India.",
    keywords: "GameInsights blog, online gaming India, fast withdrawal guide, UPI gaming guide",
    type: "Blog"
  },
  "/gamehubapp": {
    name: "gamehubapp Guide",
    title: "gamehubapp Guide | Login, Recharge, Withdrawal & Player Support",
    description: "Read the gamehubapp guide for fast login access, recharge support, withdrawal order number checks, and player support information.",
    keywords: "gamehubapp, gamehubapp login, GameHub recharge, GameHub withdrawal, GameHub support",
    type: "WebPage"
  },
  "/blog/unlock-your-potential-discover-gamehubapp": {
    name: "gamehubapp Review",
    title: "gamehubapp Review | Fast Login, Recharge, Withdraw and Player Support Guide",
    description: "A complete gamehubapp review covering login access, recharge help, withdrawal status checks, order number guidance, and player support.",
    keywords: "gamehubapp review, gamehubapp login, GameHub recharge guide, GameHub withdrawal support, gamehubapp support",
    type: "Article"
  },
  ...gamehubPromoProfiles,
  "/faqs": {
    name: "GameInsights FAQs",
    title: "GameInsights FAQs | Payments, Login, Games, Bonuses & Support",
    description: "Find answers about GameInsights login, registration, payment methods, withdrawals, bonuses, games, and customer support.",
    keywords: "GameInsights FAQ, GameInsights support, GameInsights payments, GameInsights withdrawal help",
    type: "FAQPage"
  },
  "/contact": {
    name: "GameInsights Support",
    title: "GameInsights Support | Account Help, Payment Help & Player Assistance",
    description: "Contact GameInsights support for account access, deposits, withdrawals, game guidance, and player assistance.",
    keywords: "GameInsights support, GameInsights contact, GameInsights payment help, GameInsights account help",
    type: "ContactPage"
  },
  "/about-us": {
    name: "About GameInsights Game",
    title: "About GameInsights Game | India Online Gaming Guides & Player Support",
    description: "Learn about GameInsights Game, its mobile-first online gaming guides, player support pages, payment information, bonuses, and responsible gaming resources.",
    keywords: "About GameInsights Game, GameInsights India, GameInsights online gaming",
    type: "AboutPage"
  },
  "/privacy-policy": {
    name: "Privacy Policy",
    title: "GameInsights Privacy Policy | Data, Support & Third-Party Link Notice",
    description: "Read the GameInsights privacy policy covering user-submitted information, support requests, third-party links, and basic security practices.",
    keywords: "GameInsights privacy policy, GameInsights data policy",
    type: "PrivacyPolicy"
  },
  "/terms-and-conditions": {
    name: "Terms & Conditions",
    title: "GameInsights Terms & Conditions | Website Use, Eligibility & Responsible Play",
    description: "Review GameInsights terms about eligibility, responsible use, content accuracy, external platforms, and local gaming compliance.",
    keywords: "GameInsights terms, GameInsights conditions, GameInsights eligibility",
    type: "WebPage"
  },
  "/responsible-gaming": {
    name: "Responsible Gaming",
    title: "GameInsights Responsible Gaming | 18+ Play, Limits & Safer Gaming",
    description: "Read GameInsights responsible gaming guidance for setting limits, avoiding risky play, staying 18+, and keeping real money gaming recreational.",
    keywords: "GameInsights responsible gaming, safe gaming India, 18+ gaming",
    type: "WebPage"
  },
  "/disclaimer": {
    name: "Disclaimer",
    title: "GameInsights Disclaimer | No Guaranteed Winnings & External Platform Notice",
    description: "Read the GameInsights disclaimer about informational guides, external gaming platforms, local compliance, and no guaranteed winnings.",
    keywords: "GameInsights disclaimer, GameInsights external platform notice",
    type: "WebPage"
  }
};

const matchedProfile = pageProfiles[normalizedPath] || {
  name: isHome ? "Home" : formatPathname(normalizedPath),
  title: `${isHome ? "GameInsights Game" : formatPathname(normalizedPath)} | GameInsights India`,
  description: "Explore GameInsights Game guides, real money games, secure payments, fast withdrawal support, and mobile-friendly online gaming information in India.",
  keywords: "GameInsights Game, GameInsights India, online gaming India",
  type: normalizedPath.startsWith("/blog/") ? "Article" : "WebPage"
};

const pageName = matchedProfile.name;
const pageTitle = matchedProfile.title;
const pageDescription = matchedProfile.description;
const pageKeywords = matchedProfile.keywords;
const ogImage = "https://static.wixstatic.com/media/dc7695_6e2dbf2a47af4afcb0b68f25be84363a~mv2.png?originWidth=1152&originHeight=576";

const siteSchema = {
  "@context": "https://schema.org",
  "@type": matchedProfile.type,
  "name": pageName,
  "headline": pageTitle,
  "description": pageDescription,
  "url": canonicalUrl,
  ...(isGameHubRelatedPath ? {
    "mentions": {
      "@type": "WebSite",
      "name": "gamehubapp",
      "url": "https://gamehub-app.co"
    },
    "about": [
      "gamehubapp login",
      "GameHub recharge support",
      "GameHub withdrawal support",
      "GameHub player support"
    ]
  } : {}),
  "publisher": {
    "@type": "Organization",
    "name": "GameInsights Game",
    "url": siteUrl
  }
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "GameInsights Game",
  "url": siteUrl,
  "inLanguage": "en-IN",
  "potentialAction": {
    "@type": "SearchAction",
    "target": `${siteUrl}/blog?search={search_term_string}`,
    "query-input": "required name=search_term_string"
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": new URL("/", siteUrl).href
    },
    ...(isHome ? [] : [{
      "@type": "ListItem",
      "position": 2,
      "name": pageName,
      "item": canonicalUrl
    }])
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How do I log in to GameInsights Game?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Open the GameInsights login page, enter your registered mobile number and password, then confirm access to reach your account dashboard."
      }
    },
    {
      "@type": "Question",
      "name": "Which games are available on GameInsights?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "GameInsights includes lottery-style games, Aviator and original games, slots, casino tables, sports betting, fishing games, and mobile-first real money game categories."
      }
    },
    {
      "@type": "Question",
      "name": "Can I use UPI on GameInsights?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "GameInsights supports popular India-friendly payment flows, including UPI options where available on the active platform."
      }
    },
    {
      "@type": "Question",
      "name": "How fast are GameInsights withdrawals?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Withdrawal timing can vary by payment method and account checks, but the platform is designed around a quick mobile payout flow."
      }
    },
    {
      "@type": "Question",
      "name": "Can I earn through referrals on GameInsights?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "GameInsights includes referral and invitation rewards. Users can share invite links or codes and unlock reward tiers when invited players become active."
      }
    }
  ]
};

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": ["SoftwareApplication", "WebApplication"],
  "name": "GameInsights Game",
  "url": siteUrl,
  "applicationCategory": "GameApplication",
  "operatingSystem": "Android, iOS, Web",
  "downloadUrl": new URL("/download", siteUrl).href,
  "screenshot": ogImage,
  "description": "GameInsights Game provides mobile-friendly access to real money games, account guides, payment support, bonuses, and fast withdrawal information for Indian players.",
  "featureList": "Lottery games, Aviator, slots, casino games, sports betting, UPI-friendly payments, referral rewards, welcome bonus, account login guides, withdrawal support",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "INR"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.7",
    "reviewCount": "18640",
    "bestRating": "5",
    "worstRating": "1"
  }
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "GameInsights Game",
  "url": siteUrl,
  "logo": "https://static.wixstatic.com/media/dc7695_7918aca1c0b346eb848923cd873c2ac1~mv2.png",
  "description": "GameInsights Game publishes online gaming guides, app access information, payment guidance, bonus information, and responsible gaming resources for Indian players.",
  "review": [
    {
      "@type": "Review",
      "author": { "@type": "Person", "name": "Amit R." },
      "datePublished": "2026-01-18",
      "reviewBody": "The GameInsights guide made registration and withdrawal steps easy to understand before I started.",
      "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5", "worstRating": "1" }
    },
    {
      "@type": "Review",
      "author": { "@type": "Person", "name": "Priya S." },
      "datePublished": "2026-02-04",
      "reviewBody": "The mobile layout is clear and the bonus information is simple to follow.",
      "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5", "worstRating": "1" }
    },
    {
      "@type": "Review",
      "author": { "@type": "Person", "name": "Rahul M." },
      "datePublished": "2026-02-22",
      "reviewBody": "Useful game categories and payment guidance for new players in India.",
      "reviewRating": { "@type": "Rating", "ratingValue": "4", "bestRating": "5", "worstRating": "1" }
    }
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.7",
    "reviewCount": "18640",
    "bestRating": "5",
    "worstRating": "1"
  }
};

const websiteSchemaJson = JSON.stringify(websiteSchema);
const siteSchemaJson = JSON.stringify(siteSchema);
const breadcrumbSchemaJson = JSON.stringify(breadcrumbSchema);
const faqSchemaJson = JSON.stringify(faqSchema);
const softwareSchemaJson = JSON.stringify(softwareSchema);
const organizationSchemaJson = JSON.stringify(organizationSchema);
const heroMobileImage = "https://static.wixstatic.com/media/dc7695_1681a3204eb2403e8dd83fe47baacdd9~mv2.webp";
const heroDesktopImage = "https://static.wixstatic.com/media/dc7695_e96bcc2d7425445f8aa4f1ab20a58bef~mv2.jpeg";
---

<html lang="en" class="w-full h-full">
  <head>
    <Head />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={pageKeywords} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    {isHome && (
      <>
        <link rel="preload" as="image" href={heroMobileImage} media="(max-width: 767px)" fetchpriority="high" />
        <link rel="preload" as="image" href={heroDesktopImage} media="(min-width: 768px)" fetchpriority="high" />
        <link rel="preconnect" href="https://static.wixstatic.com" crossorigin />
        <link rel="dns-prefetch" href="https://static.wixstatic.com" />
      </>
    )}
    <script type="application/ld+json" is:inline set:html={websiteSchemaJson} />
    <script type="application/ld+json" is:inline set:html={siteSchemaJson} />
    <script type="application/ld+json" is:inline set:html={breadcrumbSchemaJson} />
    {(isHome || normalizedPath === "/login" || normalizedPath === "/faqs") && (
      <script type="application/ld+json" is:inline set:html={faqSchemaJson} />
    )}
    {isHome && (
      <script type="application/ld+json" is:inline set:html={softwareSchemaJson} />
    )}
    {isHome && (
      <script type="application/ld+json" is:inline set:html={organizationSchemaJson} />
    )}
  </head>

  <body class="w-full h-full">
    <div id="root" class="w-full h-full">
      <AppRouter client:only="react" />
    </div>
  </body>
</html>
